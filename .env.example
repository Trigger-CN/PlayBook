# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- 自建 PostgreSQL（当前主用；留空则整站回退到文件/种子适配器）---
# 留空时：页面、构建、启动全部正常，但点赞/评论/浏览量等互动接口会显式报错，
# 提示需要配置数据库。填入连接串后自动切换到 PostgreSQL 实现，页面代码无需改动。
# 格式：postgres://用户:密码@主机:端口/库名
DATABASE_URL=""

# 需要 TLS 时设为 require（多数托管库如 Neon/Supabase 需要）；本机自建库留空。
DATABASE_SSL=""

# 连接池上限，留空默认 10。Serverless 环境建议调小（如 3）。
DATABASE_POOL_MAX=""

# --- Supabase（可选，用于将来替换自建库；留空不影响运行）---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# server-only：绝不可出现在客户端 bundle 或日志里。
SUPABASE_SERVICE_ROLE_KEY=""

# --- 互动数据哈希盐（可选但生产必填）---
# 用于把访客 IP / UA / 邮箱变成不可逆哈希。留空时使用「进程内随机盐」：
# 不泄漏原始值，但每次重启后哈希值都不同，去重与限流效果会重置。
INTERACTION_HASH_SALT=""

# --- Admin ---
# 管理员邮箱白名单，逗号分隔。未配置时整个后台关闭（刻意的安全默认值）。
ADMIN_EMAIL=""

# --- Cloudflare Turnstile (used from Phase 6 onward) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
